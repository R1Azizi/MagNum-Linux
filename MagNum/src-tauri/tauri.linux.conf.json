{
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": ["zenity", "chromium | chromium-browser | google-chrome"]
      }
    },
    "resources": {
      "resources/backend": null,
      "resources/backend/*.js": "backend/",
      "resources/backend/package*.json": "backend/",
      "resources/backend/magnum-fs": "backend/magnum-fs",
      "resources/backend/node_modules": "backend/node_modules"
    }
  }
}
